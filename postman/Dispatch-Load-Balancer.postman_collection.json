{
  "info": {
    "name": "Dispatch Load Balancer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order: 1 -> 2 -> 3. Folder 'Edge cases' and 'Validation errors' are independent."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "1. Submit vehicles",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dispatch",
                "vehicles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicles\": [\n    {\n      \"vehicleId\": \"VEH001\",\n      \"capacity\": 100,\n      \"currentLatitude\": 28.7041,\n      \"currentLongitude\": 77.1025,\n      \"currentAddress\": \"Karol Bagh, Delhi, India\"\n    },\n    {\n      \"vehicleId\": \"VEH002\",\n      \"capacity\": 80,\n      \"currentLatitude\": 28.5355,\n      \"currentLongitude\": 77.391,\n      \"currentAddress\": \"Sector 18, Noida, Uttar Pradesh, India\"\n    },\n    {\n      \"vehicleId\": \"VEH003\",\n      \"capacity\": 120,\n      \"currentLatitude\": 28.4595,\n      \"currentLongitude\": 77.0266,\n      \"currentAddress\": \"Cyber Hub, Gurgaon, Haryana, India\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Submit orders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dispatch",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orders\": [\n    {\n      \"orderId\": \"ORD001\",\n      \"latitude\": 28.6139,\n      \"longitude\": 77.209,\n      \"address\": \"Connaught Place, Delhi, India\",\n      \"packageWeight\": 15,\n      \"priority\": \"HIGH\"\n    },\n    {\n      \"orderId\": \"ORD002\",\n      \"latitude\": 28.6139,\n      \"longitude\": 77.209,\n      \"address\": \"Connaught Place, Delhi, India\",\n      \"packageWeight\": 10,\n      \"priority\": \"MEDIUM\"\n    },\n    {\n      \"orderId\": \"ORD003\",\n      \"latitude\": 28.7041,\n      \"longitude\": 77.1025,\n      \"address\": \"Karol Bagh, Delhi, India\",\n      \"packageWeight\": 28,\n      \"priority\": \"LOW\"\n    },\n    {\n      \"orderId\": \"ORD004\",\n      \"latitude\": 28.5355,\n      \"longitude\": 77.391,\n      \"address\": \"Sector 18, Noida, Uttar Pradesh, India\",\n      \"packageWeight\": 22,\n      \"priority\": \"HIGH\"\n    },\n    {\n      \"orderId\": \"ORD005\",\n      \"latitude\": 28.4595,\n      \"longitude\": 77.0266,\n      \"address\": \"Cyber Hub, Gurgaon, Haryana, India\",\n      \"packageWeight\": 35,\n      \"priority\": \"MEDIUM\"\n    },\n    {\n      \"orderId\": \"ORD006\",\n      \"latitude\": 28.5245,\n      \"longitude\": 77.1855,\n      \"address\": \"Saket, Delhi, India\",\n      \"packageWeight\": 18,\n      \"priority\": \"HIGH\"\n    },\n    {\n      \"orderId\": \"ORD007\",\n      \"latitude\": 28.6304,\n      \"longitude\": 77.2177,\n      \"address\": \"Janpath, Delhi, India\",\n      \"packageWeight\": 12,\n      \"priority\": \"LOW\"\n    },\n    {\n      \"orderId\": \"ORD008\",\n      \"latitude\": 28.5672,\n      \"longitude\": 77.21,\n      \"address\": \"Lajpat Nagar, Delhi, India\",\n      \"packageWeight\": 26,\n      \"priority\": \"MEDIUM\"\n    },\n    {\n      \"orderId\": \"ORD009\",\n      \"latitude\": 28.4089,\n      \"longitude\": 77.3178,\n      \"address\": \"Sector 15, Faridabad, Haryana, India\",\n      \"packageWeight\": 30,\n      \"priority\": \"LOW\"\n    },\n    {\n      \"orderId\": \"ORD010\",\n      \"latitude\": 28.6692,\n      \"longitude\": 77.4538,\n      \"address\": \"Raj Nagar, Ghaziabad, Uttar Pradesh, India\",\n      \"packageWeight\": 20,\n      \"priority\": \"HIGH\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get dispatch plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/plan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dispatch",
                "plan"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('no vehicle exceeds capacity', () => p.vehicles.forEach(v => pm.expect(v.totalLoad).to.be.at.most(v.capacity)));",
                  "pm.test('every order is assigned or reported', () => pm.expect(p.summary.assignedOrders + p.summary.unassignedOrders).to.eql(p.summary.totalOrders));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Edge cases",
      "item": [
        {
          "name": "Submit edge-case orders (overweight + capacity pressure)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dispatch",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orders\": [\n    {\n      \"orderId\": \"EDGE001\",\n      \"latitude\": 28.6139,\n      \"longitude\": 77.209,\n      \"address\": \"Connaught Place, Delhi, India\",\n      \"packageWeight\": 500,\n      \"priority\": \"HIGH\"\n    },\n    {\n      \"orderId\": \"EDGE002\",\n      \"latitude\": 28.6304,\n      \"longitude\": 77.2177,\n      \"address\": \"Janpath, Delhi, India\",\n      \"packageWeight\": 90,\n      \"priority\": \"HIGH\"\n    },\n    {\n      \"orderId\": \"EDGE003\",\n      \"latitude\": 28.5672,\n      \"longitude\": 77.21,\n      \"address\": \"Lajpat Nagar, Delhi, India\",\n      \"packageWeight\": 90,\n      \"priority\": \"MEDIUM\"\n    },\n    {\n      \"orderId\": \"EDGE004\",\n      \"latitude\": 28.5245,\n      \"longitude\": 77.1855,\n      \"address\": \"Saket, Delhi, India\",\n      \"packageWeight\": 90,\n      \"priority\": \"LOW\"\n    },\n    {\n      \"orderId\": \"EDGE005\",\n      \"latitude\": 28.4089,\n      \"longitude\": 77.3178,\n      \"address\": \"Sector 15, Faridabad, Haryana, India\",\n      \"packageWeight\": 110,\n      \"priority\": \"LOW\"\n    },\n    {\n      \"orderId\": \"EDGE006\",\n      \"latitude\": 28.6692,\n      \"longitude\": 77.4538,\n      \"address\": \"Raj Nagar, Ghaziabad, Uttar Pradesh, India\",\n      \"packageWeight\": 70,\n      \"priority\": \"HIGH\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get plan (EDGE001 must be unassigned)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/plan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dispatch",
                "plan"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('no vehicle exceeds capacity', () => p.vehicles.forEach(v => pm.expect(v.totalLoad).to.be.at.most(v.capacity)));",
                  "pm.test('every order is assigned or reported', () => pm.expect(p.summary.assignedOrders + p.summary.unassignedOrders).to.eql(p.summary.totalOrders));"
                ]
              }
            }
          ]
        }
      ]
    },
